{
  "components": {
    "schemas": {
      "HomeStatsMessage": {
        "properties": {
          "streak_days": {
            "description": "Current streak in consecutive UTC calendar days.",
            "minimum": 0,
            "type": "integer"
          },
          "total_sessions": {
            "description": "Non-skipped completed workouts and challenge days.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "streak_days",
          "total_sessions"
        ],
        "type": "object"
      },
      "HomeStatsResponse": {
        "properties": {
          "message": {
            "$ref": "#/components/schemas/HomeStatsMessage"
          },
          "status": {
            "enum": [
              "success"
            ],
            "example": "success",
            "type": "string"
          }
        },
        "required": [
          "message",
          "status"
        ],
        "type": "object"
      }
    }
  },
